1. Variables / colecciones nuevas que se usan
colFiltroAct → actividades seleccionadas (columna Valor)
colFiltroPers → personas seleccionadas (columna Valor)
gRendMedSet, gMedHorasSet, gMedMatSet → medianas globales del set filtrado
gOrdRendF, gOrdRendA → estado de orden de los botones REND
2. Carga base (agregar rendimiento por registro, necesario para la mediana)

Control: btnCargarAnaSet
Ubicación: scrSets > conRaiz_Sets > conVista_Detalle > Container17
Propiedad: OnSelect

=Set(gSetAnalizado; gSetActivo.SetName);;
ClearCollect(
    colBaseSet;
    ForAll(
        Filter(
            REGISTRO_PERSONAL1;
            SetName = gSetActivo.SetName;
            Estado.Value = "Finalizado";
            FechaInicio >= Coalesce(dpDesde.SelectedDate; Date(2020; 1; 1));
            FechaInicio < DateAdd(Coalesce(dpHasta.SelectedDate; Today()); 1; TimeUnit.Days)
        ) As _r;
        With(
            {
                _h: Coalesce(_r.HorasTotales; 0);
                _m: Value(Coalesce(_r.CantidadMateriales; "0"))
            };
            {
                SetName:   Coalesce(_r.SetName; "");
                FechaRaw:  Date(Year(_r.FechaInicio); Month(_r.FechaInicio); Day(_r.FechaInicio));
                FechaTxt:  Text(_r.FechaInicio; "[$-es]dd/mm/yyyy");
                Codigo:    Coalesce(_r.CODIGO; "s/c");
                Persona:   Coalesce(_r.NombrePersona; "Sin nombre");
                Actividad: Coalesce(_r.Job; "Sin actividad");
                SubAct:    Coalesce(_r.SubActividad.Value; "N/A");
                Horas:     _h;
                Mat:       _m;
                Frutos:    Coalesce(_r.NumeroFrutos; 0);
                Rend:      If(_h > 0; _m / _h; 0)
            }
        )
    )
);;
Set(gSetTrunc; CountRows(colBaseSet) >= 2000);;
Select(btnRecalcAnaSet)
3. Recálculo con filtros múltiples + mediana

Control: btnRecalcAnaSet
Ubicación: scrSets > conRaiz_Sets > conVista_Detalle > Container17
Propiedad: OnSelect

=ClearCollect(
    colSetFiltrado;
    Filter(
        colBaseSet;
        SetName = gSetActivo.SetName;
        (IsEmpty(colFiltroAct)  Or Actividad in colFiltroAct.Valor);
        (IsEmpty(colFiltroPers) Or Persona   in colFiltroPers.Valor);
        (IsBlank(dpDesde.SelectedDate) Or FechaRaw >= dpDesde.SelectedDate);
        (IsBlank(dpHasta.SelectedDate) Or FechaRaw <= dpHasta.SelectedDate)
    )
);;
Set(
    gRendPromSet;
    With({ _h: Sum(colSetFiltrado; Horas); _m: Sum(colSetFiltrado; Mat) }; If(_h > 0; _m / _h; 0))
);;
Set(
    gRendMedSet;
    With(
        { _o: Sort(colSetFiltrado; Rend; SortOrder.Ascending); _n: CountRows(colSetFiltrado) };
        If(
            _n = 0; 0;
            Mod(_n; 2) = 1; Last(FirstN(_o; (_n + 1) / 2)).Rend;
            (Last(FirstN(_o; _n / 2)).Rend + Last(FirstN(_o; _n / 2 + 1)).Rend) / 2
        )
    )
);;
Set(
    gMedHorasSet;
    With(
        { _o: Sort(colSetFiltrado; Horas; SortOrder.Ascending); _n: CountRows(colSetFiltrado) };
        If(
            _n = 0; 0;
            Mod(_n; 2) = 1; Last(FirstN(_o; (_n + 1) / 2)).Horas;
            (Last(FirstN(_o; _n / 2)).Horas + Last(FirstN(_o; _n / 2 + 1)).Horas) / 2
        )
    )
);;
Set(
    gMedMatSet;
    With(
        { _o: Sort(colSetFiltrado; Mat; SortOrder.Ascending); _n: CountRows(colSetFiltrado) };
        If(
            _n = 0; 0;
            Mod(_n; 2) = 1; Last(FirstN(_o; (_n + 1) / 2)).Mat;
            (Last(FirstN(_o; _n / 2)).Mat + Last(FirstN(_o; _n / 2 + 1)).Mat) / 2
        )
    )
);;
ClearCollect(
    colAnaSetFecha;
    ForAll(
        GroupBy(colSetFiltrado; 'FechaRaw'; 'FechaTxt'; 'Codigo'; 'Persona'; 'Actividad'; 'SubAct'; '_d') As _g;
        With(
            {
                _h: Sum(_g._d; Horas);
                _m: Sum(_g._d; Mat);
                _n: CountRows(_g._d);
                _o: Sort(_g._d; Rend; SortOrder.Ascending)
            };
            {
                FechaRaw:  _g.FechaRaw;
                Fecha:     _g.FechaTxt;
                Codigo:    _g.Codigo;
                Persona:   _g.Persona;
                Actividad: _g.Actividad;
                SubAct:    _g.SubAct;
                Horas:     Round(_h; 2);
                Mat:       _m;
                Frutos:    Sum(_g._d; Frutos);
                Registros: _n;
                Rend:      If(_h > 0; Round(_m / _h; 1); 0);
                Mediana:   If(
                               _n = 0; 0;
                               Mod(_n; 2) = 1; Round(Last(FirstN(_o; (_n + 1) / 2)).Rend; 1);
                               Round((Last(FirstN(_o; _n / 2)).Rend + Last(FirstN(_o; _n / 2 + 1)).Rend) / 2; 1)
                           )
            }
        )
    )
);;
ClearCollect(
    colAnaSetAcum;
    ForAll(
        GroupBy(colSetFiltrado; 'Codigo'; 'Persona'; 'Actividad'; '_d') As _g;
        With(
            {
                _h: Sum(_g._d; Horas);
                _m: Sum(_g._d; Mat);
                _n: CountRows(_g._d);
                _o: Sort(_g._d; Rend; SortOrder.Ascending)
            };
            {
                Codigo:    _g.Codigo;
                Persona:   _g.Persona;
                Actividad: _g.Actividad;
                SubAct:    Concat(Distinct(_g._d; SubAct); Value; ", ");
                Dias:      CountRows(Distinct(_g._d; FechaTxt));
                Registros: _n;
                Desde:     First(Sort(_g._d; FechaRaw; SortOrder.Ascending)).FechaTxt;
                Hasta:     First(Sort(_g._d; FechaRaw; SortOrder.Descending)).FechaTxt;
                Horas:     Round(_h; 2);
                Mat:       _m;
                Frutos:    Sum(_g._d; Frutos);
                Rend:      If(_h > 0; Round(_m / _h; 1); 0);
                Mediana:   If(
                               _n = 0; 0;
                               Mod(_n; 2) = 1; Round(Last(FirstN(_o; (_n + 1) / 2)).Rend; 1);
                               Round((Last(FirstN(_o; _n / 2)).Rend + Last(FirstN(_o; _n / 2 + 1)).Rend) / 2; 1)
                           )
            }
        )
    )
);;
Set(gSetHayFrutos; Sum(colSetFiltrado; Frutos) > 0);;
ClearCollect(
    colKpiSet;
    With(
        {
            _h: Sum(colSetFiltrado; Horas);
            _m: Sum(colSetFiltrado; Mat);
            _f: Sum(colSetFiltrado; Frutos)
        };
        Table(
            { Orden: 1; Titulo: "HORAS INVERTIDAS";     Valor: Text(Round(_h; 2)); Hex: "#0E7C86"; Mostrar: true };
            { Orden: 2; Titulo: "MAT / OPERACIONES";    Valor: Text(_m); Hex: "#2F9E44"; Mostrar: true };
            { Orden: 3; Titulo: "REND PROMEDIO (m/h)";  Valor: If(_h > 0; Text(Round(_m / _h; 1)); "0"); Hex: "#2563EB"; Mostrar: true };
            { Orden: 4; Titulo: "REND MEDIANA (m/h)";   Valor: Text(Round(gRendMedSet; 1)); Hex: "#7C3AED"; Mostrar: true };
            { Orden: 5; Titulo: "MEDIANA HORAS";        Valor: Text(Round(gMedHorasSet; 2)); Hex: "#0E7C86"; Mostrar: true };
            { Orden: 6; Titulo: "MEDIANA MAT/OPER";     Valor: Text(Round(gMedMatSet; 1)); Hex: "#2F9E44"; Mostrar: true };
            { Orden: 7; Titulo: "FRUTOS";               Valor: Text(_f); Hex: "#E8A93C"; Mostrar: _f > 0 };
            { Orden: 8; Titulo: "PERSONAS";             Valor: Text(CountRows(Distinct(colSetFiltrado; Persona))); Hex: "#1E7A33"; Mostrar: true };
            { Orden: 9; Titulo: "DÍAS TRABAJADOS";      Valor: Text(CountRows(Distinct(colSetFiltrado; FechaTxt))); Hex: "#6B7A6F"; Mostrar: true };
            { Orden: 10; Titulo: "REGISTROS";           Valor: Text(CountRows(colSetFiltrado)); Hex: "#94A5B3"; Mostrar: true }
        )
    )
)

