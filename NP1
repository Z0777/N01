```

### btnRecalcDias — OnSelect

Calcula lo que falte y **lo escribe en la lista**, no solo en memoria.

```
=ClearCollect(
    colRawAna;
    Filter(
        'EXPORT-IMPORT';
        !IsBlank(Request_ID) && CreatedDate >= varAnaIni && CreatedDate <= varAnaFin
    )
);;
ClearCollect(
    colDiasPend;
    Filter(
        colRawAna;
        (IsBlank(Dias_Lab) && !IsBlank(Coalesce('Mother plants Lab report'; 'Lab Report'))) ||
        (IsBlank(Dias_Empaque) && !IsBlank('Pack/treat completed')) ||
        (IsBlank(Dias_IP) && !IsBlank('IP Received')) ||
        (IsBlank(Dias_GL) && !IsBlank('GL Received')) ||
        (IsBlank(Dias_Transito) && !IsBlank('Arrival to customs')) ||
        (IsBlank(Dias_Aduana) && !IsBlank('Delivery Date')) ||
        (IsBlank(Dias_Ciclo) && !IsBlank('Delivery Date')) ||
        (IsBlank(Dias_Solicitud) && !IsBlank('Shipping Date')) ||
        (IsBlank(Desv_Fecha) && !IsBlank('Shipping Date') && !IsBlank(REQUESTED_SHIP_DATE))
    )
);;
ForAll(
    colDiasPend As _r;
    Patch(
        'EXPORT-IMPORT';
        LookUp('EXPORT-IMPORT'; ID = _r.ID);
        {
            Dias_Lab: If(
                IsBlank(Coalesce(_r.'FPPO Mother plants sampling'; _r.'Seed sample ToBRFV')) ||
                IsBlank(Coalesce(_r.'Mother plants Lab report'; _r.'Lab Report'));
                Blank();
                DateDiff(
                    Coalesce(_r.'FPPO Mother plants sampling'; _r.'Seed sample ToBRFV');
                    Coalesce(_r.'Mother plants Lab report'; _r.'Lab Report');
                    TimeUnit.Days
                )
            );
            Dias_Empaque: If(
                IsBlank(_r.'Pack/treat start') || IsBlank(_r.'Pack/treat completed');
                Blank();
                DateDiff(_r.'Pack/treat start'; _r.'Pack/treat completed'; TimeUnit.Days)
            );
            Dias_IP: If(
                IsBlank(_r.'IP Request') || IsBlank(_r.'IP Received');
                Blank();
                DateDiff(_r.'IP Request'; _r.'IP Received'; TimeUnit.Days)
            );
            Dias_GL: If(
                IsBlank(_r.'GL Request') || IsBlank(_r.'GL Received');
                Blank();
                DateDiff(_r.'GL Request'; _r.'GL Received'; TimeUnit.Days)
            );
            Dias_Transito: If(
                IsBlank(_r.'Shipping Date') || IsBlank(_r.'Arrival to customs');
                Blank();
                DateDiff(_r.'Shipping Date'; _r.'Arrival to customs'; TimeUnit.Days)
            );
            Dias_Aduana: If(
                IsBlank(_r.'Arrival to customs') || IsBlank(_r.'Delivery Date');
                Blank();
                DateDiff(_r.'Arrival to customs'; _r.'Delivery Date'; TimeUnit.Days)
            );
            Dias_Solicitud: If(
                IsBlank(_r.CreatedDate) || IsBlank(_r.'Shipping Date');
                Blank();
                DateDiff(_r.CreatedDate; _r.'Shipping Date'; TimeUnit.Days)
            );
            Dias_Ciclo: If(
                IsBlank(_r.CreatedDate) || IsBlank(_r.'Delivery Date');
                Blank();
                DateDiff(_r.CreatedDate; _r.'Delivery Date'; TimeUnit.Days)
            );
            Desv_Fecha: If(
                IsBlank(_r.REQUESTED_SHIP_DATE) || IsBlank(_r.'Shipping Date');
                Blank();
                DateDiff(_r.REQUESTED_SHIP_DATE; _r.'Shipping Date'; TimeUnit.Days)
            );
            EnTiempo: If(
                IsBlank(_r.REQUESTED_SHIP_DATE) || IsBlank(_r.'Shipping Date');
                Blank();
                If(DateDiff(_r.REQUESTED_SHIP_DATE; _r.'Shipping Date'; TimeUnit.Days) <= 0; "Si"; "No")
            )
        }
    )
);;
If(
    CountRows(colDiasPend) > 0;
    ClearCollect(
        colRawAna;
        Filter('EXPORT-IMPORT'; !IsBlank(Request_ID) && CreatedDate >= varAnaIni && CreatedDate <= varAnaFin)
    );;
    Notify(CountRows(colDiasPend) & " fila(s) actualizadas con dias transcurridos"; NotificationType.Success)
)
```

> Sube el límite de filas de datos a 2000 en Configuración → General. Si el histórico rebasa eso en un rango, filtra por año en `dtpAnaIni`/`dtpAnaFin`; cada carga es un solo rango, no toda la lista.

