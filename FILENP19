Set(gTermRegistro; LookUp(TERMINOS_ACEPTACION; Title = gCorreoUsuario And VersionTerminos = TerminosVersion));;
Set(varPopTerminos; IsBlank(gTermRegistro));;
ClearCollect(colActividades; ListaActividades);;
ClearCollect(colRendCat; Filter(RENDIMIENTOS_CATALOGO; Nivel = 1));;
ForAll(Sequence(7; 2) As _nv; Collect(colRendCat; Filter(RENDIMIENTOS_CATALOGO; Nivel = _nv.Value)))
