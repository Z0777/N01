btnTermAceptar.OnSelect:

powerfx
Set(
    gTermRegistro;
    IfError(
        Patch(
            TERMINOS_ACEPTACION;
            Defaults(TERMINOS_ACEPTACION);
            {
                Title:           gCorreoUsuario;
                NombreUsuario:   User().FullName;
                VersionTerminos: TerminosVersion;
                FechaAceptacion: Now();
                Aceptado:        true;
                Origen:          "Personal"
            }
        );
        Blank()
    )
);;
If(
    IsBlank(gTermRegistro.ID);
    Notify("❌ No se pudo registrar tu aceptación. Revisa tu conexión e intenta de nuevo."; NotificationType.Error);
    Set(varPopTerminos; false);;
    Reset(chkTerminos);;
    Notify("✅ Gracias. Tu aceptación quedó registrada."; NotificationType.Success)
)

