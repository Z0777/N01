### 5.2 OnSelect completo

```
=Set(varCab; LookUp('EXPORT-IMPORT'; ID = varReqExportSel.ID));;
Set(varCabVacia; IsBlank(varCab.SET));;
Set(varPrimerSetID; If(varCabVacia; First(colSetsExpNuevos).SetID; -9999));;

// ---------- 1) Si la cabecera venía sin SET: actualizarla con el PRIMERO ----------
If(
    varCabVacia;
    With({S: First(colSetsExpNuevos)};
        Patch('EXPORT-IMPORT'; varCab;
            {
                SET: S.SetName;
                CROP: {Value: S.Crop};
                Program: S.Program;
                Trial_Intent: S.TrialIntent;
                OperationType: S.OperationType;
                VCR: S.VCR;
                Field: S.Field;
                Season: S.Season;
                Area: S.Area;
                Actividad: "Envio de semillas";
                PACKING_LIST: varCab.Request_ID & " - " & S.Area;
                EsSetManual: S.EsManual;
                BOAEmail: Coalesce(varCab.BOAEmail; varUsuarioEmail; User().Email)
            }
        );;
        Patch(SOLICITUDESPA1; Defaults(SOLICITUDESPA1);
            {
                Actividad: "Envio de semillas";
                SetName: S.SetName; Crop: S.Crop; Program: S.Program; Generation: S.Generation;
                MCT: S.MCT; Trial_Intent: S.TrialIntent; OperationType: S.OperationType;
                VCR: S.VCR; Field: S.Field; PEA: varCab.PEA; Area: S.Area; Season: S.Season;
                Request_ID: varCab.Request_ID;
                SHIP_TO_LOCATION: varCab.SHIP_TO_LOCATION;
                'Requested Date': Coalesce(varCab.REQUESTED_SHIP_DATE; gloFechaEntregaEst);
                FechaSolicitud: Coalesce(varCab.CreatedDate; Now());
                Estatus: "Solicitado";
                BOA: Coalesce(varCab.BOA; gloUsuario);
                BOAEmail: Coalesce(varCab.BOAEmail; varUsuarioEmail; User().Email);
                Prioridad: Coalesce(varCab.Prioridad; "Estandar");
                PACKING_LIST: varCab.Request_ID & " - " & S.Area;
                EsSetManual: S.EsManual
            }
        )
    )
);;

// ---------- 2) El resto de SETs crean filas nuevas en AMBAS listas ----------
ForAll(
    Filter(colSetsExpNuevos; SetID <> varPrimerSetID) As S;
    Patch('EXPORT-IMPORT'; Defaults('EXPORT-IMPORT');
        {
            Actividad: "Envio de semillas";
            SET: S.SetName;
            CROP: {Value: S.Crop};
            Program: S.Program;
            Trial_Intent: S.TrialIntent;
            OperationType: S.OperationType;
            VCR: S.VCR;
            Field: S.Field;
            Season: S.Season;
            Area: S.Area;
            Request_ID: varCab.Request_ID;
            SHIP_TO_LOCATION: varCab.SHIP_TO_LOCATION;
            SHIP_TO_COUNTRY: varCab.SHIP_TO_COUNTRY;
            TYPE_OF_SHIPMENT: varCab.TYPE_OF_SHIPMENT;
            REQUESTED_SHIP_DATE: varCab.REQUESTED_SHIP_DATE;
            CreatedDate: Coalesce(varCab.CreatedDate; Now());
            SHIPMENT_PROGRESS: varCab.SHIPMENT_PROGRESS;
            PackingListEmitida: varCab.PackingListEmitida;
            PackingListEmpacado: varCab.PackingListEmpacado;
            PEA: varCab.PEA;
            BOA: Coalesce(varCab.BOA; gloUsuario);
            BOAEmail: Coalesce(varCab.BOAEmail; varUsuarioEmail; User().Email);
            Prioridad: Coalesce(varCab.Prioridad; "Estandar");
            PACKING_LIST: varCab.Request_ID & " - " & S.Area;
            EsSetManual: S.EsManual
        }
    );;
    Patch(SOLICITUDESPA1; Defaults(SOLICITUDESPA1);
        {
            Actividad: "Envio de semillas";
            SetName: S.SetName; Crop: S.Crop; Program: S.Program; Generation: S.Generation;
            MCT: S.MCT; Trial_Intent: S.TrialIntent; OperationType: S.OperationType;
            VCR: S.VCR; Field: S.Field; PEA: varCab.PEA; Area: S.Area; Season: S.Season;
            Request_ID: varCab.Request_ID;
            SHIP_TO_LOCATION: varCab.SHIP_TO_LOCATION;
            'Requested Date': Coalesce(varCab.REQUESTED_SHIP_DATE; gloFechaEntregaEst);
            FechaSolicitud: Coalesce(varCab.CreatedDate; Now());
            Estatus: "Solicitado";
            BOA: Coalesce(varCab.BOA; gloUsuario);
            BOAEmail: Coalesce(varCab.BOAEmail; varUsuarioEmail; User().Email);
            Prioridad: Coalesce(varCab.Prioridad; "Estandar");
            PACKING_LIST: varCab.Request_ID & " - " & S.Area;
            EsSetManual: S.EsManual
        }
    )
);;
Refresh('EXPORT-IMPORT');;
Refresh(SOLICITUDESPA1);;
Select(btnBuildDash);;
Notify("✅ " & CountRows(colSetsExpNuevos) & " SET(s) agregados al ID " & varCab.Request_ID; NotificationType.Success);;
Clear(colSetsExpNuevos);;
Set(varPopupAddSets; false)
```

**Comportamiento clave:**
- Si el Request_ID llegó **sin SET**, la fila original se **actualiza** con el primero (no se duplica la cabecera).
- Los demás SETs crean filas nuevas heredando todo el encabezado.
- **Cada SET produce un registro en las dos listas.**

