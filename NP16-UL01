4.5 btnEjecutarScan → OnSelect — REEMPLAZAR COMPLETO

Este reemplazo quita el texto suelto, guarda AREA y CATEGORIA como {Value: } y corrige ESTADO.Value en _hPrev:

powerfx
=If(
    gAccionScan = "CIERRE_E_INGRESO";
    Patch(
        REGIST;
        gRegAbierto;
        {
            ESTADO:       {Value: "SIN SALIDA"};
            DIA_LABORADO: true;
            OBSERVACION:  "Salida no marcada. Cerrado automáticamente al registrar ingreso del " & Text(Now(); "dd/mm/yyyy hh:mm")
        }
    );;
    Patch(
        ASISTENCIA_RESUMEN;
        Coalesce(gResumenScan; Defaults(ASISTENCIA_RESUMEN));
        {
            Title:             gCodScan;
            Nombre:            gPersonaScan.Nombre;
            UltimoDiaLaborado: gUltEf;
            DiasConsecutivos:  gConsEf;
            DiasLaboradosAcum: Coalesce(gResumenScan.DiasLaboradosAcum; 0) + If(IsBlank(gResumenScan.UltimoDiaLaborado) Or gUltEf <> gResumenScan.UltimoDiaLaborado; 1; 0)
        }
    );;
    Set(gResumenScan; LookUp(ASISTENCIA_RESUMEN; Title = gCodScan));;
    RemoveIf(colAdentro; ID = gRegAbierto.ID);;
    Set(gAccionScan; "INGRESO")
);;
If(
    gAccionScan = "INGRESO";
    Set(
        gRegNuevo;
        Patch(
            REGIST;
            Defaults(REGIST);
            {
                Title:              gCodScan & " - " & Text(Today(); "yyyymmdd");
                FECHA:              Today();
                CODIGO:             gCodScan;
                NOMBRE:             gPersonaScan.Nombre;
                TIPO:               "Empleado";
                AREA:               {Value: If(IsBlank(gPersonaScan.SEDE); gSedeGarita; gPersonaScan.SEDE)};
                DEPARTAMENTO:       gPersonaScan.DEPARTAMENTO;
