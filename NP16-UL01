                GRUPO_JORNADA:      If(IsBlank(gPersonaScan.GrupoJornada); "L-V"; gPersonaScan.GrupoJornada);
                INGRESO:            Now();
                ESTADO:             {Value: "ADENTRO"};
                DIA_LABORADO:       false;
                DIA_CONSECUTIVO:    gRachaScan;
                DIA_DESCANSO:       Not(fxEsDiaLaboral(gGrupoScan.DiasLaborales; Today()));
                EXCEPCION:          gExcepcion;
                JUSTIFICACION:      gJustifExc;
                AUTORIZA_EXCEPCION: gAutorizaExc;
                REGISTRA_INGRESO:   gCorreoUsuario
            }
        )
    );;
    Collect(colAdentro; gRegNuevo);;
    Patch(
        ASISTENCIA_RESUMEN;
        Coalesce(gResumenScan; Defaults(ASISTENCIA_RESUMEN));
        { Title: gCodScan; Nombre: gPersonaScan.Nombre; EstadoSitio: "ADENTRO"; UltimoIngreso: Now() }
    );;
    If(
        gExcepcion And gCorreoAlertaScan <> "";
        IfError(
            Office365Outlook.SendEmailV2(
                gCorreoAlertaScan;
                "⛔ Ingreso por excepción: " & gPersonaScan.Nombre;
                "<div style='font-family:Segoe UI'><p><b>" & EncodeHTML(gPersonaScan.Nombre) & "</b> (" & gCodScan & ") ingresó el " & Text(Now(); "dd/mm/yyyy hh:mm") & " superando el límite de días laborados.</p>" &
                "<p>Día consecutivo: <b>" & gRachaScan & "</b> · Días en 7: <b>" & gDias7Scan & "</b></p>" &
                "<p>Justificación: <i>" & EncodeHTML(gJustifExc) & "</i><br>Autorizó: <b>" & EncodeHTML(gAutorizaExc) & "</b><br>Registró: " & gCorreoUsuario & "</p></div>";
                { Importance: "High" }
            );
            Notify("No se pudo enviar el aviso al supervisor."; NotificationType.Warning)
        )
    );;
    Set(
        gUltimoScan;
        {
            Nombre:  gPersonaScan.Nombre;
            Tipo:    "INGRESO";
            Hora:    Now();
            Hex:     If(gExcepcion; "#E8A93C"; "#2F9E44");
            Mensaje: gPersonaScan.DEPARTAMENTO & " · día " & gRachaScan & " consecutivo" &
                     If(fxEsDiaLaboral(gGrupoScan.DiasLaborales; Today()); ""; " · DÍA DE DESCANSO según su jornada") &
                     If(gExcepcion; " · INGRESO POR EXCEPCIÓN"; "") &
                     If(IsBlank(gPermisoHoy); ""; " · 📝 permiso " & gPermisoHoy.TipoPermiso & " " & Text(gPermisoHoy.FechaInicio; "hh:mm") & "-" & Text(gPermisoHoy.FechaFin; "hh:mm"))
        }
    )
);;
If(
    gAccionScan = "SALIDA";
    With(
        {
            _h:     Round(DateDiff(gRegAbierto.INGRESO; Now(); TimeUnit.Minutes) / 60; 2);
            _hPrev: Sum(Filter(colDiaScan; ID <> gRegAbierto.ID And ESTADO.Value = "AFUERA"); Coalesce(HORAS; 0));
            _esp:   fxHorasEsperadas(gGrupoScan.DiasLaborales; gGrupoScan.HorasDia; gGrupoScan.HorasUltimoDia; gRegAbierto.FECHA)
        };
        With(
            {
                _hDia:      _hPrev + _h;
                _yaContado: gResumenScan.UltimoDiaLaborado = gRegAbierto.FECHA
            };
            With(
                { _heSeg: Round(Max(0; _hDia - _esp) - Max(0; _hPrev - _esp); 2) };
                Patch(
                    REGIST;
                    gRegAbierto;
                    {
                        SALIDA:          Now();
                        ESTADO:          {Value: "AFUERA"};
                        HORAS:           _h;
                        DIA_LABORADO:    _hDia >= HorasMinDiaLaborado;
                        HE_REALES:       _heSeg;
                        REGISTRA_SALIDA: gCorreoUsuario
                    }
                );;
                Patch(
                    ASISTENCIA_RESUMEN;
                    Coalesce(gResumenScan; Defaults(ASISTENCIA_RESUMEN));
                    {
                        Title:             gCodScan;
                        Nombre:            gPersonaScan.Nombre;
                        EstadoSitio:       "AFUERA";
                        UltimaSalida:      Now();
                        HorasSitioAcum:    Coalesce(gResumenScan.HorasSitioAcum; 0) + _h;
                        HEDetectadasAcum:  Coalesce(gResumenScan.HEDetectadasAcum; 0) + _heSeg;
                        DiasLaboradosAcum: Coalesce(gResumenScan.DiasLaboradosAcum; 0) + If(_hDia >= HorasMinDiaLaborado And Not(_yaContado); 1; 0);
                        DiasConsecutivos:  If(
                                               _hDia >= HorasMinDiaLaborado And Not(_yaContado);
                                               If(gResumenScan.UltimoDiaLaborado = DateAdd(gRegAbierto.FECHA; -1; TimeUnit.Days); Coalesce(gResumenScan.DiasConsecutivos; 0) + 1; 1);
                                               Coalesce(gResumenScan.DiasConsecutivos; 0)
                                           );
                        UltimoDiaLaborado: If(_hDia >= HorasMinDiaLaborado; gRegAbierto.FECHA; gResumenScan.UltimoDiaLaborado)
                    }
                );;
                RemoveIf(colAdentro; ID = gRegAbierto.ID);;
                Set(
                    gUltimoScan;
                    {
                        Nombre:  gPersonaScan.Nombre;
                        Tipo:    "SALIDA";
                        Hora:    Now();
                        Hex:     "#2563EB";
                        Mensaje: Text(_h; "[$-es]0,0") & " h en este tramo · día: " & Text(_hDia; "[$-es]0,0") & " h" &
                                 If(_hDia >= HorasMinDiaLaborado; " · ✔ día laborado"; " · ✖ aún no completa " & HorasMinDiaLaborado & " h") &
                                 If(_heSeg > 0; " · HE detectadas: " & Text(_heSeg; "[$-es]0,0") & " h"; "")
                    }
                )
            )
        )
    )
);;
