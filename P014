                    { Importance: "Normal" }
                );
                Notify("No se pudo enviar el aviso a " & c.Value; NotificationType.Warning)
            )
        );;
        ClearCollect(colSolicitudesHE; Filter(SOLICITUDES_HORAS_EXTRAS; FechaRequerida >= DateAdd(Today(); -120; TimeUnit.Days)));;
        ClearCollect(colAcumuladosHE; BD_HORAS_EXTRAS_ACUMULADAS);;
        Notify("✅ " & CountRows(colSeleccionados) & " solicitudes guardadas y autorizadas por " & _autoriza & "."; NotificationType.Success);;
        Clear(colSeleccionados);;
        Reset(txtJustificacion155);;
        Select(btnCalcDispHE)
    )
