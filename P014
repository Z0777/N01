btnGuardarPermiso.OnSelect:

powerfx
=With(
    {
        _p:   cmbPermPersona.Selected;
        _dia: tglPermDiaCompleto.Value;
        _hi:  Value(Left(txtPermHoraIni.Text; 2)) * 60 + Value(Right(txtPermHoraIni.Text; 2));
        _hf:  Value(Left(txtPermHoraFin.Text; 2)) * 60 + Value(Right(txtPermHoraFin.Text; 2));
