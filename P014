1. FÓRMULAS DE APP (App → Fórmulas)

AGREGAR al final del archivo de fórmulas:

powerfx
MaxHorasRegistro = 9;;
MaxHorasDiaPersona = 9;;
MinRegMeta = 5;;
MinRegAlta = 30;;
MinPersAlta = 5;;
MinRegMedia = 10;;
MinPersMedia = 3;;

SetsSinMaterialOK = ["Actividades varias"; "Otros"];;
ActividadesSinMaterialOK = ["Actividades varias"; "Otros"; "Ausencias"; "Entrenamientos"; "Oficina"];;

fxMct(m: Text): Text =
    With(
        {x: Trim(Coalesce(m; ""))};
        If(
            IsBlank(x); "N/A";
            Lower(x) in ["varios"; "various"]; "Varios";
            x
        )
    );;

fxSub(s: Text): Text =
    With({x: Trim(Coalesce(s; ""))}; If(IsBlank(x) Or Lower(x) = "n/a"; "(sin subactividad)"; x));;

fxTxt(t: Text): Text =
    With({x: Trim(Coalesce(t; ""))}; If(IsBlank(x); "N/A"; x));;

fxClave(nivel: Number; gen: Text; mct: Text; prog: Text; op: Text; act: Text; sub: Text): Text =
    Switch(
        nivel;
        1; fxTxt(gen) & "|" & fxMct(mct) & "|" & fxTxt(prog) & "|" & fxTxt(op) & "|" & fxTxt(act) & "|" & fxSub(sub);
        2; fxTxt(gen) & "|" & fxMct(mct) & "|" & fxTxt(prog) & "|*|" & fxTxt(act) & "|" & fxSub(sub);
        3; fxTxt(gen) & "|" & fxMct(mct) & "|*|*|" & fxTxt(act) & "|" & fxSub(sub);
        "*|*|*|*|" & fxTxt(act) & "|" & fxSub(sub)
    );;

fxConfiab(reg: Number; pers: Number): Text =
    If(
        reg >= MinRegAlta And pers >= MinPersAlta; "Alta";
        reg >= MinRegMedia And pers >= MinPersMedia; "Media";
        "Baja"
    );;

fxCumpleColor(mediana: Number; p25: Number; meta: Number): Color =
    If(
        meta <= 0; RGBA(150; 150; 150; 0,3);
        mediana >= meta; RGBA(47; 158; 68; 0,18);
        mediana >= p25; RGBA(232; 169; 60; 0,22);
        RGBA(220; 38; 38; 0,16)
    );;

