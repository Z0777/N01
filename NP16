btnGuardarPermiso.OnSelect:

powerfx
=With(
    {
        _p:   cmbPermPersona.Selected;
        _dia: tglPermDiaCompleto.Value;
        _hi:  Value(Left(txtPermHoraIni.Text; 2)) * 60 + Value(Right(txtPermHoraIni.Text; 2));
        _hf:  Value(Left(txtPermHoraFin.Text; 2)) * 60 + Value(Right(txtPermHoraFin.Text; 2));
        _aut: fxPuede("permisos_autorizar")
    };
    With(
        {
            _ini: If(_dia; dpPermDesde.SelectedDate; DateAdd(dpPermDesde.SelectedDate; _hi; TimeUnit.Minutes));
            _fin: If(_dia; DateAdd(dpPermHasta.SelectedDate; 1439; TimeUnit.Minutes); DateAdd(dpPermHasta.SelectedDate; _hf; TimeUnit.Minutes));
            _hDia: Coalesce(LookUp(colGruposJornada; Title = Coalesce(_p.GrupoJornada; "L-V")).HorasDia; JornadaEfectiva)
        };
        If(
            !IsBlank(LookUp(SOLICITUDES_PERMISOS; Codigo = _p.CODIGO And Estado <> "Rechazado" And FechaInicio < _fin And FechaFin > _ini));
            Notify("⚠️ " & _p.Nombre & " ya tiene un permiso que se cruza con ese horario."; NotificationType.Error);
            Patch(
                SOLICITUDES_PERMISOS;
                Defaults(SOLICITUDES_PERMISOS);
                {
                    Title:             _p.CODIGO & " - " & Text(_ini; "dd/mm/yyyy");
                    Codigo:            _p.CODIGO;
                    NombrePersona:     _p.Nombre;
                    Departamento:      _p.DEPARTAMENTO;
                    TipoPermiso:       drpPermTipo.Selected.Value;
                    FechaInicio:       _ini;
                    FechaFin:          _fin;
                    DiaCompleto:       _dia;
                    Horas:             If(_dia; (DateDiff(dpPermDesde.SelectedDate; dpPermHasta.SelectedDate; TimeUnit.Days) + 1) * _hDia; Round(DateDiff(_ini; _fin; TimeUnit.Minutes) / 60; 2));
                    Motivo:            Trim(txtPermMotivo.Text);
                    Estado:            If(_aut; "Autorizado"; "Pendiente");
                    SolicitadoPor:     User().FullName;
                    FechaSolicitud:    Now();
                    AutorizadoPor:     If(_aut; User().FullName; "");
                    FechaAutorizacion: If(_aut; Now(); Blank())
                }
            );;
            Select(btnCargarPermisos);;
            Reset(cmbPermPersona);; Reset(txtPermMotivo);; Reset(dpPermDesde);; Reset(dpPermHasta);;
            Notify(If(_aut; "✅ Permiso registrado y autorizado."; "📩 Solicitud enviada, pendiente de autorización."); NotificationType.Success)
        )
    )
)

