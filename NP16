fxEsDiaLaboral(dias: Text; fecha: Date): Boolean =
    (";" & Weekday(fecha; StartOfWeek.Monday) & ";") in (";" & Substitute(Coalesce(dias; "1;2;3;4;5"); " "; "") & ";");;

fxHorasEsperadas(dias: Text; hDia: Number; hUlt: Number; fecha: Date): Number =
    If(
        Not(fxEsDiaLaboral(dias; fecha)); 0;
        Weekday(fecha; StartOfWeek.Monday) = Value(Last(Split(Coalesce(dias; "1;2;3;4;5"); ";")).Value); Coalesce(hUlt; 8);
        Coalesce(hDia; 9)
    );;

fxDiasTexto(dias: Text): Text =
    Concat(
        Split(Coalesce(dias; ""); ";");
        Switch(Value(ThisRecord.Value); 1; "L"; 2; "Ma"; 3; "Mi"; 4; "J"; 5; "V"; 6; "S"; 7; "D"; "?");
        "-"
    );;
