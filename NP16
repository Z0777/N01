        };
        If(
            IsBlank(dpPermDesde.SelectedDate) Or IsBlank(dpPermHasta.SelectedDate); "⚠️ Selecciona las fechas.";
            _fin <= _ini; "⚠️ La fecha/hora final debe ser mayor a la inicial.";
            "🕒 " & Text(_ini; "dd/mm/yyyy hh:mm") & " → " & Text(_fin; "dd/mm/yyyy hh:mm") & " · " &
            If(_dia; (DateDiff(dpPermDesde.SelectedDate; dpPermHasta.SelectedDate; TimeUnit.Days) + 1) & " día(s)"; Round(DateDiff(_ini; _fin; TimeUnit.Minutes) / 60; 2) & " h")
        )
