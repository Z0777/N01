9. MÓDULO DE EVALUACIONES — CORRECCIONES
9.1 btnBuildMatriz — MODIFICAR OnSelect

Ubicación: Personal > btnBuildMatriz

Corrige: la nota validada se calculaba con pesos fijos aunque faltaran evaluaciones (penalizaba a quien solo tenía 1 ó 2). Ahora se normaliza por los pesos realmente presentes. Además se añade el rendimiento real filtrado y el criterio resumido con nota, número de evaluaciones y estado.

powerfx
=ClearCollect(
    colMatriz;
    ForAll(
        GroupBy(colEvalPersona; 'Actividad'; 'Cultivo'; 'grupo') As g;
        With(
            {
                rAuto: Filter(g.grupo; Tipos.Value = "Autoevaluación");
                rEnc:  Filter(g.grupo; Tipos.Value = "Encargado");
                rResp: Filter(g.grupo; Tipos.Value = "Responsable");
                regs:  Filter(
                           colRegPersona;
                           (Job = g.Actividad || SubActividad.Value = g.Actividad);
                           Estado.Value = "Finalizado";
                           HorasTotales > 0;
                           HorasTotales <= MaxHorasRegistro
                       )
            };
            With(
                {
                    va: If(CountRows(rAuto) > 0; Average(rAuto; Puntaje); 0);
                    ve: If(CountRows(rEnc)  > 0; Average(rEnc;  Puntaje); 0);
                    vr: If(CountRows(rResp) > 0; Average(rResp; Puntaje); 0);
                    pa: If(CountRows(rAuto) > 0; pesoAuto; 0);
                    pe: If(CountRows(rEnc)  > 0; pesoEnc;  0);
                    pr: If(CountRows(rResp) > 0; pesoResp; 0);
                    horas: Sum(regs; Coalesce(HorasTotales; MinutosTotales / 60; 0));
                    ops:   Sum(regs; Value(Coalesce(CantidadMateriales; "0")))
                };
                {
                    Actividad:    g.Actividad;
                    Cultivo:      g.Cultivo;
                    Auto:         Round(va; 1);
                    Enc:          Round(ve; 1);
                    Resp:         Round(vr; 1);
                    NumEval:      CountRows(g.grupo);
                    NotaValidada: If(pa + pe + pr > 0; Round((va * pa + ve * pe + vr * pr) / (pa + pe + pr); 1); 0);
                    OpHora:       If(horas > 0; Round(ops / horas; 1); 0);
                    Registros:    CountRows(regs);
                    Faltan:       (CountRows(rAuto) = 0) Or (CountRows(rEnc) = 0) Or (CountRows(rResp) = 0)
                }
            )
        )
    )
);;

ClearCollect(
    colCritResumen;
    ForAll(
        factoresEval As f;
        With(
            {
                enc:  Filter(colCritPersona; Criterio = f.Campo And Tipos.Value = "Encargado");
                resp: Filter(colCritPersona; Criterio = f.Campo And Tipos.Value = "Responsable")
            };
            With(
                {
                    ve: If(CountRows(enc)  > 0; Average(enc;  Puntaje); 0);
                    vr: If(CountRows(resp) > 0; Average(resp; Puntaje); 0);
                    pe: If(CountRows(enc)  > 0; pesoEnc;  0);
                    pr: If(CountRows(resp) > 0; pesoResp; 0)
                };
                With(
                    { nota: If(pe + pr > 0; Round((ve * pe + vr * pr) / (pe + pr); 1); 0) };
                    {
                        Orden:     f.Orden;
                        Criterio:  f.Etiqueta;
                        Enc:       Round(ve; 1);
                        Resp:      Round(vr; 1);
                        Nota:      nota;
                        NumEval:   CountRows(enc) + CountRows(resp);
                        Evaluador: Coalesce(Last(Sort(enc; FechaEvaluacion; SortOrder.Ascending)).Evaluador; "—");
                        UltimaFecha: Last(Sort(Table({f: Last(Sort(enc; FechaEvaluacion; SortOrder.Ascending)).FechaEvaluacion}; {f: Last(Sort(resp; FechaEvaluacion; SortOrder.Ascending)).FechaEvaluacion}); f; SortOrder.Ascending)).f;
                        Estado:    Switch(
                                       true;
                                       nota >= 3,5; "Supera las expectativas";
                                       nota >= 3;   "Cumple las expectativas";
                                       nota >= 2;   "Necesita mejorar";
                                       nota > 0;    "Deficiente";
                                       "Sin evaluar"
                                   )
                    }
                )
            )
        )
    )
)
