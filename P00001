OnSelect:

powerfx
=Set(gMetaDesde; Coalesce(dpMetaDesde.SelectedDate; DateAdd(Today(); -180; TimeUnit.Days)));;
Set(gMetaHasta; DateAdd(Coalesce(dpMetaHasta.SelectedDate; Today()); 1; TimeUnit.Days));;

ClearCollect(
    colMetaBruto;
    ForAll(
        Filter(
            REGISTRO_PERSONAL1;
            Estado.Value = "Finalizado";
            HorasTotales > 0;
            HorasTotales <= MaxHorasRegistro;
            FechaInicio >= gMetaDesde;
            FechaInicio < gMetaHasta
        ) As _r;
        With(
            {
                _h: Coalesce(_r.HorasTotales; 0);
                _m: Value(Coalesce(_r.CantidadMateriales; "0"));
                _fi: Date(Year(_r.FechaInicio); Month(_r.FechaInicio); Day(_r.FechaInicio));
                _ff: Date(Year(_r.FechaFin); Month(_r.FechaFin); Day(_r.FechaFin))
            };
            {
                Codigo:      Coalesce(_r.CODIGO; "s/c");
                Persona:     Coalesce(_r.NombrePersona; "Sin nombre");
                SetName:     Coalesce(_r.SetName; "Sin set");
                Actividad:   fxTxt(_r.Job);
                SubAct:      fxSub(_r.SubActividad.Value);
                Gen:         fxTxt(_r.Generation);
                Mct:         fxMct(_r.MTC);
                Prog:        fxTxt(_r.Program);
                TipoOp:      fxTxt(_r.TypeOperation.Value);
                Cultivo:     fxTxt(_r.Cultivo);
                FechaRaw:    _fi;
                MismoDia:    DateDiff(_fi; _ff; TimeUnit.Days) = 0;
                Horas:       _h;
                Mat:         _m;
                Rend:        If(_h > 0; _m / _h; 0)
            }
        )
    )
);;

ClearCollect(
    colMetaDiaExcl;
    ForAll(
        Filter(
            ForAll(
                GroupBy(colMetaBruto; 'FechaRaw'; 'Codigo'; '_d') As _g;
                {
                    ClaveDia: Text(_g.FechaRaw; "[$-es]yyyymmdd") & "|" & _g.Codigo;
                    HorasDia: Sum(_g._d; Horas)
                }
            );
            HorasDia > MaxHorasDiaPersona
        ) As _x;
        { ClaveDia: _x.ClaveDia }
    )
);;

ClearCollect(
    colMetaRaw;
    Filter(
        ForAll(
            colMetaBruto As _b;
            {
                Codigo: _b.Codigo; Persona: _b.Persona; SetName: _b.SetName;
                Actividad: _b.Actividad; SubAct: _b.SubAct;
                Gen: _b.Gen; Mct: _b.Mct; Prog: _b.Prog; TipoOp: _b.TipoOp;
                Horas: _b.Horas; Mat: _b.Mat; Rend: _b.Rend;
                MismoDia: _b.MismoDia;
                DiaOk: Not(
                    (Text(_b.FechaRaw; "[$-es]yyyymmdd") & "|" & _b.Codigo) in colMetaDiaExcl.ClaveDia
                );
                MatOk: _b.Mat > 0
                       Or _b.SetName in SetsSinMaterialOK
                       Or _b.Actividad in ActividadesSinMaterialOK
            }
        );
        MismoDia;
        DiaOk;
        MatOk;
        Rend > 0
    )
);;

ClearCollect(
    colMetaLargo;
    Ungroup(
        Table(
            { _t: ForAll(colMetaRaw As r; { Nivel: 1; Clave: fxClave(1; r.Gen; r.Mct; r.Prog; r.TipoOp; r.Actividad; r.SubAct); Actividad: r.Actividad; SubAct: r.SubAct; Gen: r.Gen;  Mct: r.Mct;  Prog: r.Prog; TipoOp: r.TipoOp; Codigo: r.Codigo; Rend: r.Rend; Horas: r.Horas; Mat: r.Mat }) };
            { _t: ForAll(colMetaRaw As r; { Nivel: 2; Clave: fxClave(2; r.Gen; r.Mct; r.Prog; r.TipoOp; r.Actividad; r.SubAct); Actividad: r.Actividad; SubAct: r.SubAct; Gen: r.Gen;  Mct: r.Mct;  Prog: r.Prog; TipoOp: "*";      Codigo: r.Codigo; Rend: r.Rend; Horas: r.Horas; Mat: r.Mat }) };
            { _t: ForAll(colMetaRaw As r; { Nivel: 3; Clave: fxClave(3; r.Gen; r.Mct; r.Prog; r.TipoOp; r.Actividad; r.SubAct); Actividad: r.Actividad; SubAct: r.SubAct; Gen: r.Gen;  Mct: r.Mct;  Prog: "*";    TipoOp: "*";      Codigo: r.Codigo; Rend: r.Rend; Horas: r.Horas; Mat: r.Mat }) };
            { _t: ForAll(colMetaRaw As r; { Nivel: 4; Clave: fxClave(4; r.Gen; r.Mct; r.Prog; r.TipoOp; r.Actividad; r.SubAct); Actividad: r.Actividad; SubAct: r.SubAct; Gen: "*";    Mct: "*";    Prog: "*";    TipoOp: "*";      Codigo: r.Codigo; Rend: r.Rend; Horas: r.Horas; Mat: r.Mat }) }
        );
        '_t'
    )
);;

ClearCollect(
    colMetasCalc;
    Filter(
        ForAll(
            GroupBy(colMetaLargo; 'Nivel'; 'Clave'; 'Actividad'; 'SubAct'; 'Gen'; 'Mct'; 'Prog'; 'TipoOp'; '_d') As g;
            With(
                {
                    _o: Sort(g._d; Rend; SortOrder.Ascending);
                    _n: CountRows(g._d)
                };
                With(
                    {
                        _l25: RoundDown(1 + (_n - 1) * 0,25; 0);
                        _f25: 1 + (_n - 1) * 0,25 - RoundDown(1 + (_n - 1) * 0,25; 0);
                        _l50: RoundDown(1 + (_n - 1) * 0,50; 0);
                        _f50: 1 + (_n - 1) * 0,50 - RoundDown(1 + (_n - 1) * 0,50; 0);
                        _l75: RoundDown(1 + (_n - 1) * 0,75; 0);
                        _f75: 1 + (_n - 1) * 0,75 - RoundDown(1 + (_n - 1) * 0,75; 0);
                        _l90: RoundDown(1 + (_n - 1) * 0,90; 0);
                        _f90: 1 + (_n - 1) * 0,90 - RoundDown(1 + (_n - 1) * 0,90; 0);
                        _nn: _n
                    };
                    With(
                        {
                            _p25: Last(FirstN(_o; _l25)).Rend + (Last(FirstN(_o; Min(_l25 + 1; _nn))).Rend - Last(FirstN(_o; _l25)).Rend) * _f25;
                            _p50: Last(FirstN(_o; _l50)).Rend + (Last(FirstN(_o; Min(_l50 + 1; _nn))).Rend - Last(FirstN(_o; _l50)).Rend) * _f50;
                            _p75: Last(FirstN(_o; _l75)).Rend + (Last(FirstN(_o; Min(_l75 + 1; _nn))).Rend - Last(FirstN(_o; _l75)).Rend) * _f75;
                            _p90: Last(FirstN(_o; _l90)).Rend + (Last(FirstN(_o; Min(_l90 + 1; _nn))).Rend - Last(FirstN(_o; _l90)).Rend) * _f90;
                            _hs: Sum(g._d; Horas);
                            _ms: Sum(g._d; Mat);
                            _np: CountRows(Distinct(g._d; Codigo))
                        };
                        {
                            Clave:         g.Clave;
                            Nivel:         g.Nivel;
                            Actividad:     g.Actividad;
                            SubActividad:  g.SubAct;
                            Generation:    g.Gen;
                            MCT:           g.Mct;
                            Program:       g.Prog;
                            OperationType: g.TipoOp;
                            RendP25:       Round(_p25; 1);
                            RendMediana:   Round(_p50; 1);
                            RendMeta:      Round(_p75; 1);
                            RendP90:       Round(_p90; 1);
                            RendPromedio:  If(_hs > 0; Round(_ms / _hs; 1); 0);
                            NumRegistros:  _nn;
                            NumPersonas:   _np;
                            Confiabilidad: fxConfiab(_nn; _np)
                        }
                    )
                )
            )
        );
        NumRegistros >= MinRegMeta
    )
);;

ForAll(
    colMetasCalc As mc;
    Patch(
        RENDIMIENTOS_CATALOGO;
        Coalesce(LookUp(RENDIMIENTOS_CATALOGO; Title = mc.Clave); Defaults(RENDIMIENTOS_CATALOGO));
        {
            Title:         mc.Clave;
            Nivel:         mc.Nivel;
            Actividad:     mc.Actividad;
            SubActividad:  mc.SubActividad;
            Generation:    mc.Generation;
            MCT:           mc.MCT;
            Program:       mc.Program;
            OperationType: mc.OperationType;
            RendP25:       mc.RendP25;
            RendMeta:      mc.RendMeta;
            RendP90:       mc.RendP90;
            RendPromedio:  mc.RendPromedio;
            RendMediana:   mc.RendMediana;
            NumRegistros:  mc.NumRegistros;
            NumPersonas:   mc.NumPersonas;
            Confiabilidad: mc.Confiabilidad;
            FechaCalculo:  Now()
        }
    )
);;

Refresh(RENDIMIENTOS_CATALOGO);;
ClearCollect(colRendCat; RENDIMIENTOS_CATALOGO);;
Notify(
    "✅ Metas recalculadas: " & CountRows(colMetasCalc) & " combinaciones | " &
    CountRows(Filter(colMetasCalc; Confiabilidad = "Alta")) & " Alta · " &
    CountRows(Filter(colMetasCalc; Confiabilidad = "Media")) & " Media · " &
    CountRows(Filter(colMetasCalc; Confiabilidad = "Baja")) & " Baja. Registros válidos: " &
    CountRows(colMetaRaw) & " de " & CountRows(colMetaBruto);
    NotificationType.Success
)

