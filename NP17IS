                    RemoveIf(colResGar; Title = gCodScan);;
                    Collect(colResGar; gResNuevo);;
                    Set(
                        gUltimoScan;
                        {
                            Nombre:  gPersonaScan.Nombre;
                            Tipo:    "SALIDA";
                            Hora:    Now();
                            Hex:     "#2563EB";
