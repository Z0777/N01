                                                           If(gResumenScan.UltimoDiaLaborado = DateAdd(gRegAbierto.FECHA; -1; TimeUnit.Days); Coalesce(gResumenScan.DiasConsecutivos; 0) + 1; 1);
                                                           Coalesce(gResumenScan.DiasConsecutivos; 0)
                                                       );
                                    UltimoDiaLaborado: If(_hDia >= HorasMinDiaLaborado; gRegAbierto.FECHA; gResumenScan.UltimoDiaLaborado)
                                }
                            )
                        )
                    );
                    Set(gRegSal; Blank())
                );;
