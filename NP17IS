            Set(gPermisoHoy; LookUp(colPermHoy; Codigo = gCodScan));;
            Set(gFechaRefScan; If(!IsBlank(gRegAbierto) And Not(gOlvido); gRegAbierto.FECHA; Today()));;
            ClearCollect(colDiaScan; Filter(colHoyGar; Upper(Trim(CODIGO)) = gCodScan; FECHA = gFechaRefScan));;
            If(
                !IsBlank(gRegAbierto) And Not(gOlvido);
                Set(gAccionScan; "SALIDA");
                With(
                    {
                        _ultSal:   First(Sort(Filter(colDiaScan; ESTADO.Value = "AFUERA"); SALIDA; SortOrder.Descending));
                        _maxCons:  Coalesce(gPersonaScan.MaxDiasConsecutivos; gCfgCat.MaxDiasConsecutivos; MaxDiasConsecDefault);
                        _maxSem:   Coalesce(gPersonaScan.MaxDiasSemana; gCfgCat.MaxDiasSemana; MaxDiasSemanaDefault);
                        _excVig:   !IsBlank(gPersonaScan.ExcepcionHasta) And gPersonaScan.ExcepcionHasta >= Today();
                        _mismoDia: !IsEmpty(colDiaScan);
                        _ultBase:  gResumenScan.UltimoDiaLaborado;
                        _consBase: Coalesce(gResumenScan.DiasConsecutivos; 0)
                    };
                    With(
                        {
                            _ultEf:  If(gOlvido And (IsBlank(_ultBase) Or gRegAbierto.FECHA > _ultBase); gRegAbierto.FECHA; _ultBase);
                            _consEf: If(
                                         gOlvido And (IsBlank(_ultBase) Or gRegAbierto.FECHA > _ultBase);
                                         If(_ultBase = DateAdd(gRegAbierto.FECHA; -1; TimeUnit.Days); _consBase + 1; 1);
                                         _consBase
                                     );
                            _dias7:  CountRows(
                                         Distinct(
                                             Filter(colSemGar; Upper(Trim(CODIGO)) = gCodScan; DIA_LABORADO = true Or ESTADO.Value = "SIN SALIDA" Or ESTADO.Value = "ADENTRO");
                                             FECHA
                                         )
                                     )
                        };
                        With(
                            { _racha: If(_ultEf = DateAdd(Today(); -1; TimeUnit.Days); _consEf; 0) };
                            Set(gUltEf; _ultEf);;
                            Set(gConsEf; _consEf);;
                            Set(gRachaScan; If(_mismoDia; Max(_consBase; 1); _racha + 1));;
                            Set(gDias7Scan; _dias7 + 1);;
                            If(
                                !IsBlank(_ultSal) And DateDiff(_ultSal.SALIDA; Now(); TimeUnit.Minutes) < AntiReboteMin;
                                Set(gAccionScan; "AVISO");;
                                Set(gMsgScan; "Registró SALIDA a las " & Text(_ultSal.SALIDA; "hh:mm") & ". No se registró ingreso (espere " & AntiReboteMin & " min).");
                                Not(_mismoDia) And Not(_excVig) And (_racha >= _maxCons Or _dias7 >= _maxSem);
                                Set(gAccionScan; "BLOQUEO");;
                                Set(gMsgScan; gPersonaScan.Nombre & " lleva " & _racha & " días consecutivos (máx. " & _maxCons & ") y " & _dias7 & " días laborados en los 6 días anteriores (máx. " & _maxSem & "). Para ingresar debe justificarse.");
                                Set(gAccionScan; If(gOlvido; "CIERRE_E_INGRESO"; "INGRESO"))
                            )
                        )
                    )
                )
            )
        )
    );;
