BLOQUE 1 — Motor de etapas (fechas en las 3 bases)
1.1 NUEVO Classic/Button btnEtapaSync

Ubicación: vExport (hijo directo, junto a Container129)
Propiedad: Visible → =false
Propiedad: OnSelect

=ClearCollect(colEtapaExp; Filter('EXPORT-IMPORT'; Request_ID = varReqPack));;
ForAll(
    Filter(colEtapaExp; !IsBlank(SET)) As _e;
    If(
        IsBlank(LookUp(SOLICITUDESPA1; Request_ID = varReqPack And SetName = _e.SET; ID));
        Patch(
            SOLICITUDESPA1;
            Defaults(SOLICITUDESPA1);
            {
                Actividad:        "Envio de semillas";
                Request_ID:       varReqPack;
                SetName:          _e.SET;
                Crop:             _e.CROP.Value;
                Program:          Coalesce(_e.Program; "NA");
                Generation:       "NA";
                MCT:              "NA";
                Trial_Intent:     Coalesce(_e.Trial_Intent; "NA");
                OperationType:    Coalesce(_e.'Operation type'.Value; "NA");
                Field:            Coalesce(_e.Field; "");
                Season:           Coalesce(_e.Season; "");
                Area:             Coalesce(_e.Area; "SSD");
                PEA:              _e.PEA;
                SHIP_TO_LOCATION: _e.SHIP_TO_LOCATION;
                Packets:          Coalesce(_e.Packets; 0);
                Net_Weight:       _e.Net_Weight;
                Gross_Weight:     _e.Gross_Weight;
                'Requested Date': _e.REQUESTED_SHIP_DATE;
                FechaSolicitud:   Coalesce(_e.CreatedDate; Now());
                BOA:              Coalesce(_e.BOA; gloUsuario);
                BOAEmail:         Coalesce(_e.BOAEmail; varUsuarioEmail; User().Email);
                Prioridad:        Coalesce(_e.Prioridad; "Estandar");
                PACKING_LIST:     varReqPack & " - " & Coalesce(_e.Area; "SSD");
                Etapa:            varEstPack;
                FechaEtapa:       varFPack;
                Estatus:          varEstPack;
                FechaInicio:      If(varEstPack = "En Proceso"; varFPack; Blank());
                FechaEntrega:     If(varEstPack in ["Packing List Emitida"; "Packing List Empacado"; "Entregado"]; varFPack; Blank());
                FechaFin:         If(varEstPack in ["Packing List Empacado"; "Entregado"]; varFPack; Blank());
                Modificado:       Now()
            }
        );
        Patch(
            SOLICITUDESPA1;
            LookUp(SOLICITUDESPA1; Request_ID = varReqPack And SetName = _e.SET);
            {
                Etapa:        varEstPack;
                FechaEtapa:   varFPack;
                Estatus:      varEstPack;
                FechaInicio:  If(varEstPack = "En Proceso"; varFPack; LookUp(SOLICITUDESPA1; Request_ID = varReqPack And SetName = _e.SET; FechaInicio));
                FechaEntrega: If(varEstPack in ["Packing List Emitida"; "Packing List Empacado"; "Entregado"]; varFPack; LookUp(SOLICITUDESPA1; Request_ID = varReqPack And SetName = _e.SET; FechaEntrega));
                FechaFin:     If(varEstPack in ["Packing List Empacado"; "Entregado"]; varFPack; LookUp(SOLICITUDESPA1; Request_ID = varReqPack And SetName = _e.SET; FechaFin));
                Modificado:   Now()
            }
        )
    )
);;
ForAll(
    Filter(colEtapaExp; !IsBlank(SET)) As _d;
    If(
        !IsBlank(LookUp(DATASUMMARY1; SetName = _d.SET; SetName));
        Patch(
            DATASUMMARY1;
            LookUp(DATASUMMARY1; SetName = _d.SET);
            {
                Request_ID:    varReqPack;
                Estatus_Envio: varEstPack;
                Fecha_Etapa:   varFPack
            }
        )
    )
);;
Refresh('EXPORT-IMPORT');;
Refresh(SOLICITUDESPA1);;
Refresh(DATASUMMARY1);;
Select(btnBuildDash);;
Notify(
    "✅ " & varEstPack & " · ID " & varReqPack & " · " &
    CountRows(colEtapaExp) & " set(s) · " & Text(varFPack; "[$-es]dd/mm/yyyy");
    NotificationType.Success
)

Columnas que deben existir: en SOLICITUDESPA1 → Etapa (texto) y FechaEtapa (fecha). En DATASUMMARY1 → Request_ID (texto), Estatus_Envio (texto), Fecha_Etapa (fecha). Si ya tienes otros nombres, cámbialos solo en esas tres líneas.

